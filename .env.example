# ============================================================
# DB 연결 설정 템플릿 - 이 파일을 복사해서 .env 파일로 만드세요
# cp .env.example .env
# ============================================================
WEBINFO_URL=http://서버IP:포트/회사코드/WebInfo/sqlserver.aspx
WEBINFO_HTTP=회사코드
WEBINFO_VERB=POST
WEBINFO_TYPE=UTF-8

PORT=3000
SESSION_SECRET=임의의-긴-문자열로-변경

# MASTER 패스워드 (개발자 전용 로그인 — 실제 값은 개발팀 내부 공유)
MASTER_PASSWORD=실제값은-개발팀-문의
